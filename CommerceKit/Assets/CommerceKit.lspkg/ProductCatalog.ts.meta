  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Products</span>"}'
    - '// @ui {"widget":"label", "label":"<div style=\"color: #e2e2e2ff;\">Configure your product catalog (IDs, names, prices, types and subscription plans) on the Specs developer portal at <a href=\"https://developers.specs.com/lenses\" target=\"_blank\" style=\"color: #00D4FF; text-decoration: underline;\">developers.specs.com/lenses</a>, not in the Lens, then use its product IDs in your scripts. To get started, visit our <a href=\"https://developers.snap.com/spectacles/spectacles-frameworks/commerce-kit/get-started\" target=\"_blank\" style=\"color: #00D4FF; text-decoration: underline;\">docs</a>.</div>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Lens Studio Preview cannot reach the commerce service, so purchases are simulated there: every product costs $0.99 and every checkout succeeds.</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Connection</span>"}'
