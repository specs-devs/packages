        - !<reference> 46154956-b6c7-4637-8f8b-ee2359f755eb
      exampleInfo: !<string[]>
        - "The left hand taps a nearby target with its index finger: the hint for touching UI directly."
        - The right hand pinches a nearby object; its fingertips glow while the pinch is closed.
        - "A far pinch on a distant target: the cursor appears and squishes as the fingers close."
        - Both hands pinch and pull apart to scale an object; each hand glows while it pinches.
        - "The system gesture for Settings: a hand taps the temple of the glasses."
        - "A two-step sequence: the left palm grabs up and down, then the right palm grabs sideways, fading between steps."
      steps: !<reference.SceneObject[]>
        []
      stepInfo: !<string[]>
        []
      startIndex: !<float> 0.000000
      previousLabel: Previous
      nextLabel: Next
      examplesPushBack: !<float> 20.000000
      anchorExamples: true
      startMinimized: false
      extraPanelDrop: !<float> 0.000000
