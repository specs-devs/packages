- !<Text/ae3c0388-1964-4b0d-bb0c-c7ec7f00e9d2>
  PrefabRemaps:
    []
  Name: Text
  Enabled: true
  RenderOrder: 11
  StretchMode: Stretch
  VerticalAlignment: Center
  HorizontalAlignment: Left
  MeshShadowMode: None
  ShadowColor: {x: 1.000000, y: 1.000000, z: 1.000000, w: 1.000000}
  ShadowDensity: 1.000000
  Text: "Raymarching draws shapes without meshes: every pixel steps a ray toward the nearest surface. Metaballs blend their distances so they melt into one gooey surface. Raise your hands, pinch the orbs and try the looks — use Previous / Next to switch example."
