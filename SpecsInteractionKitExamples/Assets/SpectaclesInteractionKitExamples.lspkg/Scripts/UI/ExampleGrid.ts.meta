    - '// @input Asset.Texture buttonImageTexture {"hint":"Placeholder image texture for buttons (optional)"}'
    - '// @input Asset.Material buttonImageMaterial {"hint":"Placeholder image material for buttons (optional)"}'
    - '// @input bool draggable {"hint":"Enable drag-and-drop rearrangement of buttons (per-page in scrollable mode)"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Paged Scroll</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">iPhone-style home screen: masked viewport, animated page slides, dot shortcuts + arrow navigation.</span>"}'
    - '// @input bool scrollable {"hint":"Enable iPhone-style horizontal paging with masked viewport, navigation arrows, and dot shortcuts"}'
    - '// @input float totalItems = 24 {"hint":"Total items spread across all pages (scrollable mode). Defaults to one page when 0.", "widget":"slider", "min":1, "max":200, "step":1}'
    - '// @input float navGridGap = 3 {"hint":"Extra gap in cm between the bottom of the grid and the navigation bar", "widget":"slider", "min":0, "max":20, "step":0.5}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Position</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">World-space placement. All panels use the same defaults so they appear at the same depth.</span>"}'
    - '// @input float positionX {"hint":"World X position (0 = horizontal centre)"}'
    - '// @input float positionY {"hint":"World Y position (0 = camera height)"}'
    - '// @input float positionZ = -110 {"hint":"Distance from camera in cm (negative = in front)"}'
