  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA; font-size: 13px;\">Programmatic UI Component</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Two horizontal carousels built at runtime. Adjust inputs and press Play to rebuild.</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Uncheck Test Mode to start empty — populate row1Items / row2Items via API before Play.</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Test Mode"}'
    - '// @input bool testMode = true {"hint":"Fill both carousels with mockup cards automatically. Uncheck to start empty and populate via row1Items / row2Items."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Panel"}'
    - '// @input string panelTitle = "Carousel" {"hint":"Title text shown at the top of the panel"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Frame"}'
    - '// @input vec2 frameInnerSize = {36,28} {"hint":"Inner content area in cm (width × height) — the frame chrome sits outside this"}'
    - '// @input vec2 framePadding = {1,1} {"hint":"Frame chrome thickness in cm — how far the rounded border extends past the content edge"}'
    - '// @input vec2 contentInset = {1.5,1} {"hint":"Inset between frame edge and carousel content — X = left/right, Y = top/bottom (cm)"}'
    - "// @input string frameAppearance = \"Large\" {\"hint\":\"Frame appearance style — 'Large' (far-field) or 'Small' (near-field)\"}"
    - '// @input bool showCloseButton = true {"hint":"Show the × close button on the frame"}'
    - '// @input bool showFollowButton = true {"hint":"Show the follow / grip button on the frame"}'
    - '// @input bool frameAutoHide {"hint":"Auto-hide the frame handle bar when idle"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Position"}'
    - '// @input float positionX {"hint":"World X position (0 = horizontal centre)"}'
    - '// @input float positionY {"hint":"World Y position (0 = camera height)"}'
    - '// @input float positionZ = -110 {"hint":"Distance from camera in cm (negative = in front)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Row 1"}'
    - '// @input string row1Label = "Featured" {"hint":"Section header label for the first row"}'
    - '// @input float row1Count = 8 {"hint":"Number of cards in row 1"}'
    - "// @input string row1CardStyle = \"PrimaryNeutral\" {\"hint\":\"Button style — e.g. 'PrimaryNeutral', 'Secondary', 'Primary'\"}"
    - "// @input string row1CardShape = \"Rectangle\" {\"hint\":\"Button shape — 'Rectangle' or 'Capsule'\"}"
    - '// @input Asset.Texture[] row1Images = {} {"hint":"Card images for row 1 (in order). If fewer than row1Count, remaining cards show a text label."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Row 2"}'
    - '// @input string row2Label = "Recommended" {"hint":"Section header label for the second row"}'
    - '// @input float row2Count = 8 {"hint":"Number of cards in row 2"}'
    - "// @input string row2CardStyle = \"Secondary\" {\"hint\":\"Button style — e.g. 'PrimaryNeutral', 'Secondary', 'Primary'\"}"
    - "// @input string row2CardShape = \"Rectangle\" {\"hint\":\"Button shape — 'Rectangle' or 'Capsule'\"}"
    - '// @input Asset.Texture[] row2Images = {} {"hint":"Card images for row 2 (in order). If fewer than row2Count, remaining cards show a text label."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Cards"}'
    - '// @input float visibleCards = 3 {"hint":"How many cards are fully visible at once per row. Card width is auto-computed to fill the carousel."}'
    - '// @input float cardGap = 0.8 {"hint":"Gap between consecutive cards in cm"}'
    - '// @input float cardImageSize = 5.5 {"hint":"Image size within the card in cm — used when a texture is supplied"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Typography"}'
    - '// @input float titleTextSize = 36 {"hint":"Font size for the panel title"}'
    - '// @input float sectionTextSize = 22 {"hint":"Font size for section header labels"}'
    - '// @input float cardTextSize = 22 {"hint":"Font size for card text labels (shown when no image is supplied)"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Font slots are optional — SpecsSans is auto-loaded from the Fonts folder when left empty.</span>"}'
    - '// @input Asset.Font fontLight {"hint":"Light weight font — auto-loads SpecsSans-Light if empty"}'
    - '// @input Asset.Font fontRegular {"hint":"Regular weight font — auto-loads SpecsSans-Regular if empty"}'
    - '// @input Asset.Font fontMedium {"hint":"Medium weight font — auto-loads SpecsSans-Medium if empty"}'
    - '// @input Asset.Font fontBold {"hint":"Bold font — auto-loads SpecsSans-Bold if empty"}'
    - '// @ui {"widget":"group_end"}'
