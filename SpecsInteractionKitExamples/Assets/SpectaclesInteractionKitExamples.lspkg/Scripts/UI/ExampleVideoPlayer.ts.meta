  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">ExampleVideoPlayer – programmatic video player</span><br/><span style=\"color: #94A3B8; font-size: 11px;\">No prefabs. Assign a VideoTexture and set duration. API: play(), pause(), resume(), stop(), seek(t), seekRelative(dt), setVolume(v), setPlaybackRate(r), isPlaying(), getCurrentTime().</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Video"}'
    - '// @input Asset.Texture videoTexture {"hint":"Video texture asset to display and control (must have VideoTextureProvider)"}'
    - '// @input number videoDuration = "60.0" {"hint":"Total video duration in seconds — drives the seek slider and time display"}'
    - '// @input bool autoPlay {"hint":"Start playing automatically when the component initializes"}'
    - '// @input number loopCount = "1" {"hint":"Loop count passed to VideoTextureProvider.play() — 0 = infinite"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Controls"}'
    - '// @input number seekStepSeconds = "5.0" {"hint":"Seconds to seek per forward / rewind button press"}'
    - '// @input bool showVolumeSlider = true {"hint":"Show the volume slider below the transport controls"}'
    - '// @input number initialVolume = "1.0" {"hint":"Initial volume (0 – 1)"}'
    - '// @input number initialPlaybackRate = "1.0" {"hint":"Initial playback rate (0.5 = half speed, 2.0 = double speed)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Layout"}'
    - '// @input number panelWidth = "32.0" {"hint":"Panel content area width in cm"}'
    - '// @input string aspectRatio = "16:9" {"hint":"Video display aspect ratio — determines the height of the video cell", "widget":"combobox", "values":[{"label":"16:9", "value":"16:9"}, {"label":"4:3", "value":"4:3"}, {"label":"1:1", "value":"1:1"}]}'
    - '// @input number positionX = "0" {"hint":"World X position"}'
    - '// @input number positionY = "0" {"hint":"World Y position"}'
    - '// @input number positionZ = "-110" {"hint":"Distance from camera in cm (negative = in front)"}'
    - '// @input number videoCornerRadius = "1.5" {"hint":"Corner radius of the video display in cm (0 = sharp corners)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Typography"}'
    - '// @input number timeLabelFontSize = "24" {"hint":"Font size for the current time / duration label"}'
    - '// @input number buttonFontSize = "20" {"hint":"Font size for the transport buttons (Play, Pause, Seek back/forward)"}'
    - '// @input number volumeLabelFontSize = "22" {"hint":"Font size for the Volume label and percentage readout"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Logging"}'
    - '// @input bool enableLogging {"hint":"Enable general logging (play, pause, seek events)"}'
    - '// @input bool enableLoggingLifecycle {"hint":"Enable lifecycle logging (onAwake, onStart)"}'
    - '// @ui {"widget":"group_end"}'
