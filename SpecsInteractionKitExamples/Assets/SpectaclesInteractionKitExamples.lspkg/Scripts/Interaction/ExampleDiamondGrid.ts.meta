  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">ExampleDiamondGrid – isometric diamond tile grid</span><br/><span style=\"color: #94A3B8; font-size: 11px;\">Tile centres follow X=halfX·(i−j), Y=halfY·(i+j). Step scalars are derived from the rotated cube AABB so tiles are flush at gap=0 for any rotation.</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @input Asset.ObjectPrefab cubePrefab {"hint":"Cube prefab to instantiate for each tile"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Grid"}'
    - '// @input float cols = 5 {"hint":"Tile count along the i-axis (right-upward diagonal in screen space)"}'
    - '// @input float rows = 5 {"hint":"Tile count along the j-axis (left-upward diagonal in screen space)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Tile"}'
    - '// @input float cubeSize = 1 {"hint":"Uniform scale applied to each tile; also sets the isometric unit step s in the formula"}'
    - '// @input float rotX = 35.264 {"hint":"X rotation in degrees — 35.264° with Y=45° is canonical isometric"}'
    - '// @input float rotY = 45 {"hint":"Y rotation in degrees"}'
    - '// @input float rotZ {"hint":"Z rotation in degrees"}'
    - '// @input float gap {"hint":"Extra spacing added to cubeSize when computing the step (s = cubeSize + gap). Negative values overlap tiles."}'
    - '// @input float depthStep {"hint":"World-Z depth offset per j-row for depth layering (0 = flat grid)"}'
    - '// @ui {"widget":"group_end"}'
