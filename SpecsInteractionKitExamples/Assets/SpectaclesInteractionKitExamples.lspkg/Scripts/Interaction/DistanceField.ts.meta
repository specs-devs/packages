  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">DistanceField – gravitational curve field</span><br/><span style=\"color: #94A3B8; font-size: 11px;\">Control points define a Catmull-Rom path. Particle clusters spawn around each point. The reference object projects onto the path and drives a gravitational repulsion field.</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Curve"}'
    - '// @input SceneObject[] controlPoints {"hint":"Scene objects that define the Catmull-Rom galaxy path (minimum 2)"}'
    - '// @input number interpolationSteps = "20" {"hint":"Interpolation steps between each pair of control points — higher = smoother curve"}'
    - '// @input bool closedLoop {"hint":"Close the curve back to the first control point"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Particle Clusters"}'
    - '// @input Asset.ObjectPrefab particlePrefab {"hint":"Prefab to instantiate inside each cluster sphere"}'
    - '// @input number instancesPerCluster = "8" {"hint":"Number of particle instances spawned per control point"}'
    - '// @input number clusterRadius = "5.0" {"hint":"Radius of the imaginary spawn sphere around each control point (cm)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Reference Object"}'
    - '// @input SceneObject referenceObject {"hint":"The object whose projection onto the curve drives the field (the spaceship)"}'
    - '// @input Asset.ObjectPrefab projectionPrefab {"hint":"Prefab placed at the projection point on the curve (optional — the red spaceship indicator)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Gravitational Field"}'
    - '// @input number pushDistance = "15.0" {"hint":"Sphere of influence: particles within this distance (cm) are repelled"}'
    - '// @input number pushStrength = "8.0" {"hint":"Maximum displacement magnitude when the projection point is at distance 0 (cm)"}'
    - '// @input number pushSmoothSpeed = "6.0" {"hint":"Smoothing speed for particle return to rest (higher = snappier)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Curve Visual"}'
    - '// @input bool showCurve = true {"hint":"Render the Catmull-Rom path as a visible line"}'
    - '// @input Asset.Material lineMaterial {"hint":"Material used to render the curve line (assign a line/unlit material)"}'
    - '// @input vec3 lineColor = "{0.2, 0.6, 1.0}" {"hint":"RGB colour of the curve line", "widget":"color"}'
    - '// @input number lineWidth = "0.4" {"hint":"Width of the curve line (cm)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Logging"}'
    - '// @input bool enableLogging {"hint":"Enable general logging (spawn counts, projection updates)"}'
    - '// @input bool enableLoggingLifecycle {"hint":"Enable lifecycle logging (onAwake, onStart)"}'
    - '// @ui {"widget":"group_end"}'
