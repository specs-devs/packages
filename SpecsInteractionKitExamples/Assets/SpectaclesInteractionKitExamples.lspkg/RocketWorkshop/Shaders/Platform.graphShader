        Node4:
          DependencyIndex: 6
          LevelID: 15
          NodeCount: 0
          NodeType: 1
          Ports:
            Code:
              ClassType1: TEXT
              String: |-
                input_int NormalSpace;
                input_vec3 Normal;
                output_vec2 ReflectionUV;
                
                void main()
                {
                	// get normal in World Space
                	vec3 normal = Normal;
                
                	if(NormalSpace == 1)
                	{	// tangent to world
                		mat3 tangentToWorld = mat3(
                			system.getSurfaceTangent(),
                			system.getSurfaceBitangent(),
                			system.getSurfaceNormal()
                		);
                		normal = normalize(tangentToWorld * normal);
                	}
                
                	// Construct a rotation matrix using view direction and camera up,
                	// then use it to rotate the world normal. This prevents puffing
                	// and warping effects when the object is close to the edge of 
                	// the viewing area.
                	vec3 forward = normalize(-system.getViewVector());
                	vec3 right = normalize(cross(forward, system.getCameraUp()));
                	vec3 up = cross(right, forward);
                	mat3 rotationMat = mat3(
                		right.x,	 up.x, forward.x,
                		right.y,	 up.y, forward.y,
                		right.z,	 up.z, forward.z
                	);
                	normal = rotationMat * normal;
                
                	// convert to UVs
                	ReflectionUV = normal.xy * 0.5 + 0.5;
                }
            Description:
              ClassType1: TEXT
              String: ""
            Examples:
              ItemIndex: 0
              ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
            ID:
              Variable: 15
            Locked:
              Variable: false
            Normal:
              Connection0:
                NodeLevelID: 13
                PortID: Value
              Variable: [0.0, 0.0, 0.0]
            NormalSpace:
              Connection0:
                NodeLevelID: 14
                PortID: Value
              Variable: 0.0
            ReflectionUV:
              IOType: 1
              Variable: [0.0, 0.0]
            Stage:
              ItemIndex: 1
              ItemList: "Vertex : Pixel"
            Title:
              String: Matcap Reflection
            ngs_Height:
              Variable: 400
            ngs_Version:
              String: 0.1.0
          PositionX: 210
          PositionY: 70
          TemplateID: node_util_custom
