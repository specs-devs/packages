        Node11:
          DependencyIndex: 159
          LevelID: 118
          NodeCount: 0
          NodeType: 1
          Ports:
            Bounciness:
              Connection0:
                NodeLevelID: 114
                PortID: Value
              Variable: 0.5
            Code:
              ClassType1: TEXT
              String: |-
                input_int OnCollision;
                input_vec3 PlanePos;
                input_vec3 PlaneNormal;
                input_float Bounciness;
                input_float Friction;
                input_float PlaneOffset;
                input_float CollisionCount;
                input_float VelocityThreshold;
                output_float SetCollisionCount;
                output_vec3 SetForce;
                output_vec3 SetVelocity;
                output_vec3 SetPosition;
                output_float KillParticle;
                
                vec3 integrateForces() {
                	vec3 velocity = system.getParticleVelocity() + system.getParticleForce()/ max(0.00001, system.getParticleMass()) * vec3(system.getTimeDelta());
                	return velocity * vec3(system.getTimeDelta()) + system.getParticlePosition();
                }
                
                vec3 getCollisionVelocity(vec3 N, float b, float f){
                    vec3 Vn = dot(N, system.getParticleVelocity()) * N;
                    vec3 Vt = system.getParticleVelocity() - Vn;
                    Vt *= (1.0 - f);
                    Vn *= b;
                    return Vt - Vn;
                }
                
                struct CollisionPlane {
                    bool isColliding;
                    vec3 velocity;
                    vec3 position;
                    vec3 force;
                };
                
                CollisionPlane planeCollision(CollisionPlane collisionPlane) {
                    
                    collisionPlane.isColliding = false;
                    collisionPlane.velocity = system.getParticleVelocity();
                    collisionPlane.force = system.getParticleForce();
                    collisionPlane.position = system.getParticlePosition();
                
                    // Collision detection, use the next frame's position
                	vec3 ptNextFrame = integrateForces();
                	vec3 planeNormal = normalize(PlaneNormal);
                    float planeDotPt = dot(planeNormal, ptNextFrame - PlanePos) - PlaneOffset;
                
                    // Collision response
                    if(planeDotPt < 0.0) {
                        collisionPlane.isColliding = true;
                        collisionPlane.velocity = getCollisionVelocity(planeNormal, Bounciness, Friction);
                        
                        // Kill forces if particle isn't bouncing
                        collisionPlane.force *= length(collisionPlane.velocity) > VelocityThreshold ? 1.0 : 0.0;
                        
                        // Move current particle position to sit on the plane 
                        float correction = dot(planeNormal, system.getParticlePosition() - PlanePos) - PlaneOffset;
                        collisionPlane.position += (planeNormal * -correction);
                    }
                    return collisionPlane;
                }
                
                void main()
                {
                    CollisionPlane collisionPlane;
                	collisionPlane = planeCollision(collisionPlane);
                	KillParticle = 0.0;
                    SetCollisionCount = floor(CollisionCount);
                
                    //Collided
                    if (collisionPlane.isColliding){
                        SetCollisionCount += 1.0;
                    }
                
                    // Bounce
                    SetPosition = collisionPlane.position;
                    SetForce = collisionPlane.force;
                    SetVelocity = collisionPlane.velocity;
                
                    // Stop
                    if(OnCollision == 1 && SetCollisionCount > 0.0){
                        SetForce = vec3(0.0);
                        SetVelocity = vec3(0.0);
                    }
                
                	//Kill
                    if(OnCollision == 2 && SetCollisionCount > 0.0){
                        KillParticle = 1.0;
                    }
                }
            CollisionCount:
              Variable: 0.0
            Description:
              ClassType1: TEXT
              String: |-
                Collide with an analytical plane given a position and normal.
                
                Bounciness is how much speed is retained on collision. Friction is how much resistence is applied when sliding on a surface. Offset displaces the particle to be on the positive side of the plane and in most cases should be equal to the particle's radius.
                
                Note that this creates a global particle attribute called 'collisionCount' that can be used to track up to 255 collisions.
            Examples:
              ItemIndex: 0
              ItemList: "Custom : System Built-In Values/Functions"
            Friction:
              Connection0:
                NodeLevelID: 115
                PortID: Value
              Variable: 0.5
            ID:
              Variable: 118
            KillParticle:
              IOType: 1
              Variable: 0.0
            Locked:
              Variable: false
            OnCollision:
              Connection0:
                NodeLevelID: 111
                PortID: Value
              Variable: 0.0
            PlaneNormal:
              Connection0:
                NodeLevelID: 113
                PortID: Value
              Variable: [0.3, 1.0, 0.0]
            PlaneOffset:
              Connection0:
                NodeLevelID: 116
                PortID: Value
              Variable: 0.0
            PlanePos:
              Connection0:
                NodeLevelID: 212
                PortID: Output
              Variable: [0.0, -10.0, 0.0]
            SetCollisionCount:
              IOType: 1
              Variable: 0.0
            SetForce:
              IOType: 1
              Variable: [0.0, 0.0, 0.0]
            SetPosition:
              IOType: 1
              Variable: [0.0, 0.0, 0.0]
            SetVelocity:
              IOType: 1
              Variable: [0.0, 0.0, 0.0]
            Stage:
              ItemIndex: 1
              ItemList: "Vertex : Pixel"
            Title:
              String: Collision ( Plane )
            VelocityThreshold:
              Variable: 2.0
            ngs_Height:
              Variable: 800
            ngs_Version:
              String: 1.0.0
