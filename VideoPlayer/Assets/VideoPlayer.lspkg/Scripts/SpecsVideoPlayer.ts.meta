  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">SpecsVideoPlayer – SpecsNDK video player</span><br/><span style=\"color: #94A3B8; font-size: 11px;\">URL playback runs natively on Specs (file:// or http(s)://). In Lens Studio Preview the VideoTexture fallback plays instead.</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Source"}'
    - '// @input string source = "url" {"hint":"url: play the URL (native on device). bundled: play the VideoTexture everywhere.", "widget":"combobox", "values":[{"label":"URL", "value":"url"}, {"label":"Bundled VideoTexture", "value":"bundled"}]}'
    - '// @input string url {"hint":"Media URL: file:///absolute/path.mp4, http:// or https://. Needs the INTERNET permission (embedded in the module)."}'
    - '// @input Asset.Texture videoTexture {"hint":"Bundled VideoTexture. Played when source = bundled, and used as the editor fallback for a URL source."}'
    - '// @input bool autoPlay = true {"hint":"Start playing as soon as the media is ready"}'
    - '// @input bool loop {"hint":"Loop at end of stream"}'
    - '// @input number volume = "1.0" {"hint":"Initial volume (0 – 1)", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Display"}'
    - '// @input Component.MaterialMeshVisual displayVisual {"hint":"Optional Image / RenderMeshVisual whose main material receives the video texture"}'
    - '// @input Asset.Material displayMaterial {"hint":"Optional material that receives the video texture (in addition to displayVisual)"}'
    - '// @input string textureParameter = "baseTex" {"hint":"Material texture parameter to write (Unlit / Image materials use baseTex)"}'
    - '// @input int maxFrameWidth = "1280" {"hint":"Max width of the RGBA frames copied from native (larger videos are scaled down, aspect kept)"}'
    - '// @input int maxFrameHeight = "720" {"hint":"Max height of the RGBA frames copied from native"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Backend"}'
    - '// @input string backend = "auto" {"hint":"auto: native on device, VideoTexture in the editor. native / videoTexture force one backend.", "widget":"combobox", "values":[{"label":"Auto", "value":"auto"}, {"label":"Native (device)", "value":"native"}, {"label":"VideoTexture", "value":"videoTexture"}]}'
    - '// @input Asset.RemoteMediaModule remoteMediaModule {"hint":"Optional: lets the VideoTexture backend stream a URL source (editor Preview) via RemoteMediaModule"}'
    - '// @input Asset.InternetModule internetModule {"hint":"Optional: InternetModule used with remoteMediaModule to make the URL resource"}'
    - '// @input bool enableLogging {"hint":"Print state changes and errors"}'
    - '// @ui {"widget":"group_end"}'
