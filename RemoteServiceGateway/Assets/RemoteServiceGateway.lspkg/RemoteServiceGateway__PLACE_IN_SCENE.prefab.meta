      systemPrompt: "You are an incredibly smart but witty AI assistant who likes to answers life's greatest mysteries in under two sentences"
      userPrompt: Is a hotdog a sandwich
      doChatCompletionsOnTap: true
      imgObject: !<reference.SceneObject> 58ae543a-2fa4-4412-5573-8ce279a2406a
      imageGenerationPrompt: The future of augmented reality
      generateImageOnTap: true
      editBaseImg: !<reference.Texture> eb55e1d2-d7db-447f-b38a-c10683f969d0
