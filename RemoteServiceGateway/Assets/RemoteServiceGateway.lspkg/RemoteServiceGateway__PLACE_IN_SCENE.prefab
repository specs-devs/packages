      systemPrompt: "You are an incredibly smart but witty AI assistant who likes to answers life's greatest mysteries in under two sentences"
      userPrompt: Is a hotdog a sandwich
      doChatCompletionsOnTap: true
      imgObject: !<reference.SceneObject> 58ae543a-2fa4-4412-aa8c-731d865dbf95
      imageGenerationPrompt: The future of augmented reality
      generateImageOnTap: true
      editBaseImg: !<reference.Texture> eb55e1d2-d7db-447f-b38a-c10683f969d0
      editMaskImg: !<reference.Texture> 1e304736-a9a5-4080-8772-726d136e0462
      editResultObject: !<reference.SceneObject> 58ae543a-2fa4-4412-aa8c-731d865dbf95
      imageEditPrompt: Add a futuristic city skyline inside the masked area
      doEditImageOnTap: true
      voiceGenerationPrompt: Get ready for the future of augmented reality with Lens Studio!
      voiceGenerationInstructions: |
        Serious, movie trailer voice, insert pauses for dramatic effect

      generateVoiceOnTap: true
      functionCallingPrompt: Make the text display yellow
      doFunctionCallingOnTap: true
      enableLogging: false
      enableLoggingLifecycle: false
