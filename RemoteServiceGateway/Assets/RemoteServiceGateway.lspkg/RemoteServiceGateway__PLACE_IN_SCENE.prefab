    "":
      examples: !<reference.SceneObject[]>
        - !<reference> f71ca437-d7ec-4524-85ec-562466932aba
        - !<reference> 09df580e-ccf7-4f46-9742-e0f47f605fd8
        - !<reference> 45b73c57-f8f9-470e-bab3-9392b08b9d0f
        - !<reference> ee751f4f-8959-4156-b37b-09f1d777c5a7
        - !<reference> d6e902bc-6951-4a75-af0a-b6781247ea2e
