- !<ScriptComponent/b7d68418-75e8-48d2-9a4a-01aef6e2f6c2>
  PrefabRemaps:
    []
  Name: ExampleCarousel
  Enabled: true
  ScriptAsset: !<reference> 7be6437d-d662-5119-b49f-2821ccd91790
  ScriptInputsDefault:
