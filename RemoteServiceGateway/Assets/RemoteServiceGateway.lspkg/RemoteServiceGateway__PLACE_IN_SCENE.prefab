        - !<reference> e8fbb47f-40b8-4af8-98cd-d191d80c1256
      exampleInfo: !<string[]>
        - "Runs by itself, one call after the other: GPT chat (left), a tool call that colors the text, GPT Image draws then edits the image (right), and a voice reads a line. The log shows each call."
        - "A realtime voice session opens with this step and the model greets you. Talk to it, or ask it to change the text color. Leaving the step closes the session and the microphone."
        - "Runs by itself: Gemini answers (left), a Gemini tool call colors the text, then Imagen (gemini-3.1-flash-image) paints the image (right). The log shows each call."
        - "A Gemini Live session opens with this step and the model greets you. Talk to it, or ask it to change the text color. Leaving the step closes the session and the microphone."
        - "Lyria composes a tune of about 30 s and plays it. Generating takes a while: follow it in the log. Leaving the step stops the music."
        - 'Runs by itself: Snap3D turns "A cute cartoony dog wearing a hat" into, from left to right, a preview image, a base mesh and a refined 3D model.'
        - "Runs by itself: Snap3D turns the image at the URL into a base mesh and a refined 3D model."
      steps: !<reference.SceneObject[]>
        []
      stepInfo: !<string[]>
        []
      startIndex: !<float> 0.000000
      previousLabel: Previous
      nextLabel: Next
      examplesPushBack: !<float> 20.000000
      anchorExamples: true
      startMinimized: false
      extraPanelDrop: !<float> 0.000000
  ScriptTypes:
    "":
      {}
- !<Text/b96d2b8b-a008-453f-b950-5a905836cb8e>
  PrefabRemaps:
