  InputLines:
    - '// @input string target = "auto" {"hint":"Top-level switch. auto = pick by isEditor(): the editor runs the Mac path, a Glasses device runs the native NDK WebRTC path. The native path resolves ONLY on device — forcing \"device\" in the editor shows a load error.", "widget":"combobox", "values":[{"label":"Auto — editor→Mac path, device→native WebRTC", "value":"auto"}, {"label":"Editor / Mac — bridge or http (see mode)", "value":"editor"}, {"label":"Device — native on-device WebRTC (NDK)", "value":"device"}]}'
    - '// @input string mode = "bridge" {"hint":"bridge = live video through DecartBridge/bridge.py (run it first). http = direct slow image API, no companion needed", "widget":"combobox", "values":[{"label":"Realtime via Mac bridge (fast)", "value":"bridge"}, {"label":"Cloud HTTP lucy-image-2 (~16s/frame)", "value":"http"}]}'
    - '// @input string bridgeUrl = "ws://localhost:8765" {"hint":"WebSocket URL of the bridge. Editor: ws://localhost:8765 — Glasses device: ws://<your-mac-LAN-ip>:8765"}'
    - '// @input number bridgeSendFps = "10" {"hint":"Camera frames per second sent to the bridge"}'
    - '// @input string nativeEndpoint = "wss://api3.decart.ai/v1/stream" {"hint":"DEVICE path only: Decart realtime WebRTC signaling endpoint (native NDK module). api_key + model are appended."}'
    - '// @input string nativeModel = "lucy-2.5" {"hint":"DEVICE path only: Decart realtime model requested by the native NDK module"}'
    - '// @input boolean nativeUseH265 = "false" {"hint":"DEVICE path only: encode the camera with H.265 (HEVC). Off = H.264 (default — Decart realtime does not support H.265; VP8/H.264 only)"}'
    - '// @input number nativeFps = "30" {"hint":"DEVICE path only: camera encode frame rate"}'
    - '// @input number nativeBitrateKbps = "6000" {"hint":"DEVICE path only: target video bitrate (kbps)"}'
    - '// @input number nativeMaxWidth = "1280" {"hint":"DEVICE path only: max camera capture width"}'
    - '// @input number nativeDownlinkKbps = "2500" {"hint":"INACTIVE — this engine has no REMB/receiver-side bitrate control, so there is no way to cap Decart’s downlink from the device. Kept only so old scenes still deserialize; changing it does nothing."}'
    - '// @input number displayZoom = "2.09" {"hint":"Display fill — UNIFORM zoom of the head-locked video quad. >1 overscans past the FOV so the feed fills the view and crops at the edges (no letterbox). Aspect is preserved, so no squish. Live-tunable via the in-app Scale slider."}'
    - '// @input number displayOffsetX = "11" {"hint":"Horizontal offset of the video quad, cm (+ = right). Live-tunable via the in-app X slider."}'
    - '// @input number displayOffsetY = "7" {"hint":"Vertical offset of the video quad, cm (+ = up). Live-tunable via the in-app Y slider."}'
    - '// @input number displayOffsetZ = "0.15" {"hint":"Depth offset of the video quad, cm (+ = nearer/bigger, − = farther/smaller). 0 = the authored ~80cm distance. Default 0.15 keeps it at that comfortable focus distance (NOT the near clip, which sits on your eyes and causes strain). Live-tunable via the in-app Z slider."}'
    - '// @input boolean matchAspect = "true" {"hint":"Size the quad to the DECODED frame aspect (e.g. 1280×704 → 1.82:1) so the video is never stretched. Off = keep the authored quad aspect."}'
    - '// @input string apiKey = "PASTE_YOUR_DECART_API_KEY" {"hint":"Decart API key — x-api-key header (http mode / on-device WebRTC; the bridge has its own key). Falls back to the DecartRequirements script."}'
    - '// @input string prompt {"hint":"Style prompt applied to the camera feed — editable at runtime via the UI text field"}'
    - '// @input string resolution = "480p" {"hint":"Decart output resolution (http mode) — 480p is lower latency", "widget":"combobox", "values":[{"label":"480p", "value":"480p"}, {"label":"720p", "value":"720p"}]}'
    - '// @input number seed = "1234" {"hint":"Fixed seed keeps frame-to-frame style coherent in http mode (0–4294967295)"}'
    - '// @input boolean enhancePrompt = "true" {"hint":"Let Decart expand the prompt server-side"}'
    - '// @input boolean autoStart = "false" {"hint":"Start automatically once the camera is ready. Off = wait for startLoop() (the UI Start button) — safest in the editor"}'
    - '// @input Component.Image targetImage {"hint":"World-space quad that displays the Decart-transformed feed"}'
    - '// @input Component.Text statusText {"hint":"Optional status readout (latency / errors)"}'
    - '// @input number startDelaySeconds = "3" {"hint":"Seconds to wait after camera-ready before the first http request"}'
    - '// @input number editorWarmupSeconds = "40" {"hint":"EDITOR ONLY extra first-request delay for http autoStart — dodges the launch-time reset storm that can crash LS 5.23 mid-request. Ignored on device and in bridge mode"}'
