    Node2:
      DependencyIndex: 5
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_texture_2d baseTexture;
            input_float fadeBottom;
            input_float fadeTop;
            input_float ambient;
            input_float lightGain;
            output_vec4 result;
            
            void main()
            {
            	vec3 albedo = baseTexture.sample(system.getSurfaceUVCoord0()).rgb;
            	vec3 n = normalize(system.getSurfaceNormalWorldSpace());
            	vec3 light = vec3(ambient);
            	for (int i = 0; i < 4; i++) {
            		if (i >= system.getDirectionalLightCount()) break;
            		vec3 l = -normalize(system.getDirectionalLightDirection(i));
            		light += max(dot(n, l), 0.0) * system.getDirectionalLightColor(i) * system.getDirectionalLightIntensity(i) * lightGain;
            	}
            	// Fade to black toward the neck: black is see-through on an additive display.
            	float y = system.getSurfacePositionObjectSpace().y;
            	float f = smoothstep(fadeBottom, fadeTop, y);
            	result = vec4(albedo * light * f, 1.0);
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Custom Code
        UseExternalFile:
          Variable: false
        baseTexture:
          ClassType2: TEXTURE_OBJECT_2D
          Connection0:
            NodeLevelID: 2
            PortID: Texture
        fadeBottom:
          Connection0:
            NodeLevelID: 1
            PortID: Output
          Variable: 0.0
        fadeTop:
          Connection0:
            NodeLevelID: 5
            PortID: Output
          Variable: 0.0
        ambient:
          Connection0:
            NodeLevelID: 6
            PortID: Output
          Variable: 0.0
        lightGain:
          Connection0:
            NodeLevelID: 7
            PortID: Output
          Variable: 0.0
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
        result:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
      PositionX: -59
      PositionY: 91
      TemplateID: node_util_custom
      TemplateVersionMinor: 2
      Title1: Custom Code
