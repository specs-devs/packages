- !<Text/27abf349-36a4-4489-8a82-3399213a1753>
  PrefabRemaps:
    []
  Name: Text
  Enabled: true
  RenderOrder: 11
  StretchMode: Stretch
  VerticalAlignment: Center
  HorizontalAlignment: Left
  MeshShadowMode: None
  ShadowColor: {x: 1.000000, y: 1.000000, z: 1.000000, w: 1.000000}
  ShadowDensity: 1.000000
  Text: |-
    Remote Assistance lets a helper see what you see and draw on it. Press START CALL and share the session code: your helper joins from the package's web portal, sees your view live, talks with you, and every stroke they draw appears as a 3D line in your space.
    
    Calls need your own Snap Cloud (Supabase) project. In the Lens Studio Preview a demo drawing plays when you start a call.
  CustomMaterial: !<reference> 00000000-0000-0000-0000-000000000000
  Editable: false
  ShowEditingPreview: true
  TouchHandler: !<reference> 00000000-0000-0000-0000-000000000000
  EnableRichText: false
  SizeToFit: false
  FontSize: 60.000000
  FontSource: !<reference> 00000000-0000-0000-0000-000000000000
  PreferredStyle: Regular
  LayoutRect:
    left: -20.000000
    bottom: -9.000000
    right: 20.000000
    top: 9.000000
  DebugRenderLayoutRect: false
  OverflowVertical: Overflow
  OverflowHorizontal: Wrap
  Fill: !<TextFill>
