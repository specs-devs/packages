  InputLines:
    - '// @ui {"widget":"label", "label":"BezierLine Examples — whiteboard-style connector board"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Assets"}'
    - '// @input Asset.RenderMesh cardMesh {"hint":"Box mesh used for the card faces (scaled to Card Size)."}'
    - '// @input Asset.RenderMesh anchorMesh {"hint":"Sphere mesh used for anchor dots and flow markers."}'
    - '// @input Asset.Material cardMaterial {"hint":"Material cloned and tinted per card."}'
    - '// @input Asset.Material anchorMaterial {"hint":"Material cloned per anchor dot (tinted with the card color on hover)."}'
    - '// @input Asset.Material connectorMaterial {"hint":"Material cloned and tinted per connector ribbon."}'
    - '// @input Asset.Material markerMaterial {"hint":"Material cloned and tinted per flow marker."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Connectors"}'
    - '// @input float lineWidth = 0.45 {"hint":"Ribbon width in cm.", "widget":"slider", "min":0.05, "max":2, "step":0.01}'
    - '// @input int segments = 32 {"hint":"Curve subdivisions per connector (2-128). Each adds two vertices.", "widget":"slider", "min":2, "max":128, "step":1}'
    - '// @input float handleLength = 15 {"hint":"Handle length in cm — how far a connector leaves a card before bending. The Whiteboard uses 15.", "widget":"slider", "min":0, "max":30, "step":0.5}'
    - '// @input bool faceCamera = true {"hint":"Rotate ribbons to face the camera so they never appear edge-on."}'
    - '// @input bool debugDraw {"hint":"Draw curve, control points and handles with the debug render system."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Board"}'
    - '// @input vec2 cardSize = {16,10} {"hint":"Card size in cm."}'
    - '// @input float anchorRadius = 0.9 {"hint":"Anchor dot radius in cm.", "widget":"slider", "min":0.4, "max":2.5, "step":0.1}'
    - '// @input bool flowMarkers = true {"hint":"Show a marker travelling along each connector (getPointAtT / getTangentAtT)."}'
    - '// @input float flowSpeed = 0.3 {"hint":"Flow marker speed in laps per second.", "widget":"slider", "min":0.05, "max":2, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
