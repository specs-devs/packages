{
  "schemaVersion": 1,
  "demoMode": true,
  "proxyUrl": "https://your-social-proxy.example.com",
  "cloud": {
    "url": "https://YOUR_PROJECT.snapcloud.dev",
    "publishableKey": ""
  },
  "capture": {
    "aspect": "portrait",
    "fps": 8,
    "maxSeconds": 12,
    "includeAudio": true
  },
  "composer": {
    "caption": "Made with Specs ✨ #Specs",
    "title": "A moment through my Specs"
  },
  "destinations": {
    "snapchat": {
      "enabled": false,
      "format": "spotlight",
      "caption": ""
    },
    "x": {
      "enabled": true,
      "format": "video",
      "caption": ""
    },
    "youtube": {
      "enabled": true,
      "format": "short",
      "caption": "",
      "privacy": "private"
    },
    "linkedin": {
      "enabled": false,
      "format": "video",
      "caption": ""
    },
    "instagram": {
      "enabled": true,
      "format": "reel",
      "caption": ""
    },
    "threads": {
      "enabled": false,
      "format": "video",
      "caption": ""
    },
    "tiktok": {
      "enabled": false,
      "format": "video",
      "caption": "",
      "publishMode": "inbox",
      "privacyLevel": "",
      "disableComment": false,
      "disableDuet": true,
      "disableStitch": true
    }
  }
}
