PORT=8787
PUBLIC_ORIGIN=https://your-social-proxy.example.com
SNAP_CLOUD_URL=https://YOUR_PROJECT.snapcloud.dev
SNAP_CLOUD_SERVICE_ROLE_KEY=
# Generate once: openssl rand -base64 32. Keep it stable to decrypt stored tokens.
TOKEN_ENCRYPTION_KEY=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# Inbox needs video.upload. For an approved Direct Post app add ,video.publish
# here and reconnect the account after changing scopes.
TIKTOK_SCOPES=user.info.basic,video.upload
LINKEDIN_VERSION=202609
INSTAGRAM_VERSION=v23.0
