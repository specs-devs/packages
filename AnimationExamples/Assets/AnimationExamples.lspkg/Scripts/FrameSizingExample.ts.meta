    - "// @ui {\"widget\":\"label\", \"label\":\"<span style=\\\"color: #F59E0B; font-size: 11px;\\\">3. Leave the Clip's Animation Asset empty to use this script's runtime curve.</span>\"}"
    - '// @ui {"widget":"label", "label":"<span style=\"color: #F59E0B; font-size: 11px;\">4. Add a SpectaclesUIKit Frame ScriptComponent — its innerSize is what this example animates.</span>"}'
