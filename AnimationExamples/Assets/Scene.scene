  ScriptInputsDefault:
    {}
  ScriptTypesDefault:
    {}
  ScriptInputs:
    "":
      manager: !<reference.SceneObject> 4b8d94db-a431-40db-8f10-f13af6999e62
      exampleNames: !<string[]>
        - ScaleSquishExample
        - PushOutZExample
        - OpacityCallbackExample
        - SubscribeToFinishExample
        - CustomTimestampEventExample
        - FromAnimationAssetExample
        - ExistingPlayerExample
        - FrameSizingExample
      exampleInfo: !<string[]>
        - Tap the frame button to replay its springy scale squish.
        - Tap to replay a push in depth with an overshoot.
        - Watch the frame fade; tap its button to replay.
        - Tap to grow the frame and fire an event when it finishes.
        - Tap to slide the frame and fire an event halfway through.
        - Tap to play the authored animation clip.
        - Tap to replay the clip configured on the existing player.
        - Tap to restart alternating frame height and width pulses.
      holderOffset: !<Vec3> {x: 0.000000, y: -33.000000, z: 0.000000}
  ScriptTypes:
    "":
      {}
