      TemplateVersionMinor: 1
      Title1: Surface Position
    Node19:
      DependencyIndex: 27
      LevelID: 59
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |
            // Inputs
            input_color4 GlowColor;
            input_float GlowFalloff;
            input_vec3 SurfacePosition;
            
            // Output
            output_vec4   OutputColor;
            
            void main()
            {
                vec3 pos       = system.getSurfacePositionObjectSpace();
                float radius   = 1.0;                     // fixed radius
                float softness = GlowFalloff;             // the single controller
                float d        = distance(pos, SurfacePosition);
            
                float glowFactor = 1.0 - smoothstep(radius - softness, radius, d);
                OutputColor = vec4(GlowColor.rgb * glowFactor, GlowColor.a * glowFactor);
            }

        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        GlowColor:
          ClassType1: COLOR
          Connection0:
            NodeLevelID: 28
            PortID: SubGraphUniqueID46
          Variable: [1.0, 1.0, 1.0, 1.0]
        GlowFalloff:
          Connection0:
            NodeLevelID: 79
            PortID: Output
          Variable: 0.0
        ID:
          Variable: 59
        Locked:
          Variable: false
        OutputColor:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        SurfacePosition:
          Connection0:
            NodeLevelID: 68
            PortID: Position
          Variable: [0.0, 0.0, 0.0]
        Title:
          String: Outer Glow
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
      PositionX: 3019
