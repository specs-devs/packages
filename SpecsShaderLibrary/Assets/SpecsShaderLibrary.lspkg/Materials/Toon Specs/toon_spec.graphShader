      Ports:
        Description:
          String: ""
        DescriptionText:
          ClassType1: TEXT
          String: |+
            Rotates a 3D mesh when given its surface position. 
            
            Input Type:
            -World Position:
            Note that this graph will transform input surface space data into object vector(space) and export as world vector.
            
            -Surface Normal:
            Apply XYZ rotation to surface normal with rotation matrix.
            
            Surface Value:
            Assign value according to your selection for the Input Type.
            
            Rotation Degree:
            Rotation value in degrees (angle).
            
        FirstTime:
          Variable: false
        Locked:
          Variable: false
