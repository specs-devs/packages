        - !<reference> 9d1c26df-41e7-43dc-75f4-17808435d718
        - !<reference> add9b63a-c5c9-4739-6cb0-e34e5c00b502
        - !<reference> cbe520a0-4e7e-4633-7480-32791d699452
        - !<reference> 8bbbf5f5-5f62-4791-5eb1-d45cccbfb795
        - !<reference> 560d65ec-71cc-4f01-5f2a-e240ca430eb8
        - !<reference> d2d4cc9f-1211-432c-7e6a-00db1c063c56
        - !<reference> ba64cd83-d18c-46b2-7632-9f813b165888
        - !<reference> c50b98dd-29f0-482c-6ac7-22973ce45eb8
        - !<reference> 7fa6e73e-54d2-4fb3-456f-e138f1c84cf7
        - !<reference> 3068a21f-5203-41ac-415b-51c2775d1c16
        - !<reference> 3a21f834-8c90-4c20-67d1-41fd191fbac5
        - !<reference> 4ace684d-7f1b-4974-4432-50ee946af05d
        - !<reference> 12907638-6997-4179-7d68-b3d1eb597434
      exampleInfo: !<string[]>
        - "TypeScript: finds the first child of Parent and checks that it has a RenderMeshVisual. What it prints appears on the log panel."
        - "The same lookup in JavaScript: the first child of Parent, then its RenderMeshVisual."
        - 'TypeScript: getComponent("Component.RenderMeshVisual") on a referenced SceneObject, and whether it was found.'
        - "The same getComponent lookup in JavaScript, on a referenced SceneObject."
        - "TypeScript: requireType() finds a custom script component, then calls its hasTexture() method and reads textureSize."
        - "JavaScript: requireType('./CustomComponentJS') finds the custom script, then calls hasTexture() and reads textureSize."
        - "TypeScript: a @typename input holds the custom component; the script calls hasTexture() and reads textureSize."
        - "JavaScript: the custom component comes from a typed input; the script calls hasTexture() and reads textureSize."
        - "JavaScript to JavaScript: component B reads A's values, calls its methods, then keeps updating A every few frames."
        - "TypeScript calls a JavaScript component through a declared interface: values, add / multiply and a value-changed callback."
        - "TypeScript calls a JavaScript component typed as any (no declaration): values, calculateSum, formatMessage, a counter and events."
        - "JavaScript calls a TypeScript component: reads its values and calls getDescription, add, multiply and the counter methods."
        - "TypeScript to TypeScript with a typed reference: B reads A's values and calls its methods (info, average, counter)."
      steps: !<reference.SceneObject[]>
        []
      stepInfo: !<string[]>
        []
      startIndex: !<float> 0.000000
      previousLabel: Previous
      nextLabel: Next
      examplesPushBack: !<float> 20.000000
      anchorExamples: true
      startMinimized: false
      extraPanelDrop: !<float> 0.000000
  ScriptTypes:
    "":
      {}
