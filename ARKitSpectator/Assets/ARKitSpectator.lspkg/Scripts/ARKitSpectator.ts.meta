    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">What to stream</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Poses are sent relative to the Stage Origin, in cm. The phone puts the Stage Origin on the surface the viewer taps.</span>"}'
    - '// @input SceneObject stageOrigin {"hint":"Reference frame for every pose (e.g. your table or play-area root). Empty = this SceneObject"}'
    - '// @input bool includeSpectatorEntities = true {"hint":"Also stream every SceneObject that has a SpectatorEntity component"}'
    - '// @input SceneObject[] trackedObjects = {} {"hint":"Extra SceneObjects to stream without a SpectatorEntity (drawn as boxes on the phone)"}'
    - '// @input string roomJson {"hint":"Optional room-level JSON sent with every update (max 8 KB). Change it at runtime with setRoomData()"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Publishing</span>"}'
    - '// @input float publishRate = 5 {"hint":"Maximum updates per second. Updates are only sent when something changed", "widget":"slider", "min":1, "max":15, "step":1}'
    - '// @input float positionTolerance = 0.2 {"hint":"Position change (cm) below which an object counts as unchanged"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Room code display</span>"}'
    - '// @input Component.Text roomCodeText {"hint":"Text that shows the room code for the phone (optional)"}'
    - '// @input string roomCodeFormat = "Spectator code\n{code}" {"hint":"Room code format; {code} is replaced by the 4 digits"}'
    - '// @input Component.Text statusText {"hint":"Text that shows connection status (optional)"}'
    - '// @input bool debugLogs {"hint":"Print connection details to the Logger"}'
