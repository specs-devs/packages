    - '// @input string authMode = "snapchat-then-anonymous" {"hint":"How the Lens signs in. The iPhone app always signs in anonymously", "widget":"combobox", "values":[{"label":"Snapchat, then anonymous", "value":"snapchat-then-anonymous"}, {"label":"Snapchat only", "value":"snapchat"}, {"label":"Anonymous only", "value":"anonymous"}]}'
