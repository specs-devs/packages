    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Snap Cloud</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Assign your SupabaseProject asset (Window → Supabase → Import Credentials) on SnapCloudRequirements and run supabase/setup.sql on that project once.</span>"}'
