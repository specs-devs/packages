<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Optional defaults for the ARKit Spectator app. Leave empty to enter them in the app (Settings).
  Use your Snap Cloud project URL and its PUBLIC (publishable / anon) key only — never a
  service-role or secret key. Room access is enforced by sign-in and row-level security.
  AllowedAssetHosts: extra hosts the app may download glTF models from, besides the project
  host. A leading "*." matches subdomains (e.g. *.example.com).
-->
<plist version="1.0">
<dict>
	<key>SupabaseURL</key>
	<string></string>
	<key>SupabasePublishableKey</key>
	<string></string>
	<key>AllowedAssetHosts</key>
	<array/>
</dict>
</plist>
