          PositionX: -150
          PositionY: 340
          TemplateID: nodes_import_float
          Title1: Float Import
          Title2: Center
        Node5:
          DependencyIndex: 75
          LevelID: 144
          NodeCount: 0
          NodeType: 1
          Ports:
            Center:
              Connection0:
                NodeLevelID: 139
                PortID: Value
              Variable: [0.0, 0.0]
            Code:
              ClassType1: TEXT
              String: |-
                input_bool Direction;
                input_vec2 UV;
                input_vec2 Scale;
                input_float RotationOffset;
                input_vec2 Center;
                
                output_vec2 PolarCoordinates;
                
                vec2 scaleAndRotateCoords(vec2 coordsIn, vec2 scale, float rotation, vec2 center){
                	float Sin = sin( radians( rotation ) );
                	float Cos = cos( radians( rotation ) );
                	vec2 coordsOut = coordsIn - center;
                	return vec2( dot( vec2( Cos, Sin ), coordsOut ), dot( vec2( -Sin, Cos ), coordsOut ) ) * scale + center;
                }
                
                void main()
                {
                	vec2 uv = UV;
                	vec2 scale = Scale * 2.0; // fix scale so default value of 1 produces a radius of 1
                	uv = scaleAndRotateCoords(uv, scale, RotationOffset, Center);
                
                	// shift uv range to [-0.5, 0.5]
                	uv -= Center;
                
                	float r = sqrt(uv.x * uv.x + uv.y * uv.y);
                	float theta = atan(uv.y, uv.x);
                
                	if(Direction) {	// counter-clockwise
                		theta = system.remap(theta, -system.pi(), system.pi(), 0.0, 1.0);
                	} else {			// clockwise
                		theta = system.remap(theta, -system.pi(), system.pi(), 1.0, 0.0);
                	}	
                
                	PolarCoordinates = vec2(r, theta);
                }
            Description:
              ClassType1: TEXT
              String: ""
            Direction:
              Connection0:
                NodeLevelID: 140
                PortID: Value
              Variable: 0.0
