- !<Text/4a7ce083-4ed9-46c5-817f-97fee536f9e2>
  PrefabRemaps:
    []
  Name: Text
  Enabled: true
  RenderOrder: 11
  StretchMode: Stretch
  VerticalAlignment: Center
  HorizontalAlignment: Left
  MeshShadowMode: None
  ShadowColor: {x: 1.000000, y: 1.000000, z: 1.000000, w: 1.000000}
  ShadowDensity: 1.000000
  Text: |-
    SnapDecorators is a TypeScript library, not a visual effect: decorators bind lifecycle events, inject components and memoize getters, so scripts need less boilerplate.
    The Examples script here prints a line for each decorator-bound event: start, enable, an update every 60 frames with frame count and FPS, late update, and destroy. Follow it in the logs while the Lens runs.
  CustomMaterial: !<reference> 00000000-0000-0000-0000-000000000000
  Editable: false
  ShowEditingPreview: true
  TouchHandler: !<reference> 00000000-0000-0000-0000-000000000000
  EnableRichText: false
  SizeToFit: false
  FontSize: 60.000000
  FontSource: !<reference> 00000000-0000-0000-0000-000000000000
  PreferredStyle: Regular
  LayoutRect:
    left: -20.000000
    bottom: -9.000000
    right: 20.000000
    top: 9.000000
  DebugRenderLayoutRect: false
  OverflowVertical: Overflow
  OverflowHorizontal: Wrap
  Fill: !<TextFill>
    Mode: Solid
    Color: {x: 1.000000, y: 1.000000, z: 1.000000, w: 1.000000}
    Texture: !<reference> 00000000-0000-0000-0000-000000000000
    ColorTint: {x: 1.000000, y: 1.000000, z: 1.000000, w: 1.000000}
    TileCount: 5.000000
    TileZone: Rect
    TextureStretch: FitWidth
  BlendMode: PremultipliedAlphaAuto
  Outline: !<OutlineSettings>
    Enabled: false
    Fill: !<TextFill>
      Mode: Solid
      Color: {x: 0.000000, y: 0.000000, z: 0.000000, w: 1.000000}
      Texture: !<reference> 00000000-0000-0000-0000-000000000000
      ColorTint: {x: 1.000000, y: 1.000000, z: 1.000000, w: 1.000000}
      TileCount: 5.000000
      TileZone: Rect
