  HorizontalAlignment: Left
  MeshShadowMode: None
  ShadowColor: {x: 1.000000, y: 1.000000, z: 1.000000, w: 1.000000}
  ShadowDensity: 1.000000
  Text: |-
    Interactable Helper connects hand interactions to visual and audio responses without writing code.
    
    Every example is a round button: hover or pinch it and watch the object above it react. Boxes toggle, scale, move and change color; the elephant animates and morphs; audio and video play; a script callback changes a label.
    
    Use Previous and Next to step through the twelve examples.
  CustomMaterial: !<reference> 00000000-0000-0000-0000-000000000000
  Editable: false
  ShowEditingPreview: true
  TouchHandler: !<reference> 00000000-0000-0000-0000-000000000000
