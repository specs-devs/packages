      examples: !<reference.SceneObject[]>
        - !<reference> 3edb27d1-35a6-4f1d-acc0-48c293b586ea
        - !<reference> 8063d0bc-965d-4e61-b47b-085a940164c5
        - !<reference> 12a920c9-98ee-44f6-b0fb-1176ee835be0
        - !<reference> 6c3308f9-e4d7-4474-802e-974cb4c71815
        - !<reference> 81ef1b77-8cf2-42d0-ae1b-f1db78b11842
        - !<reference> 444470aa-a7a5-4827-ba72-54f65911bf7b
        - !<reference> 98284687-94f6-4842-bf72-29f586b9f9fd
        - !<reference> c85c2f18-beab-4279-8878-9495d45bad4d
        - !<reference> d65a1c16-3b2c-434a-9bc4-d2ecea7a42be
        - !<reference> 48b7b900-9f4b-422b-ac9c-bc9d0f0581b6
