  Description: Automatic, self-calibrating floor-height estimation for Spectacles. Continuously estimates the real-world floor using batched WorldQuery ray fans with plausibility bounds, voting, and height-jump hysteresis, then locks when stable and revalidates at low frequency, unlocking automatically on drift. Pin objects to the floor via Target Objects or consume the height through a typed script API with floor-updated and calibration-state events.
  SvgIcon: |
    <svg width="420" height="420" viewBox="0 0 420 420" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
    <image width="420" height="420" xlink:href="data:image/png;base64,"/>
    </svg>

  SetupScript:
    code: |
      return function instantiate(asset, scene, target, instantiator) {
        try {
          var assetManager = instantiator.getAssetManager();
          // Dual path resolution: development layout (Assets/AutoFloorFinder.lspkg/...) vs
          // post-Contentful layout (Package/Assets/...). Try sibling path first, then the
          // restructured fallback, per specs-packages "Path Handling for Contentful Deployment".
          var scriptMeta = null;
          var candidates = [
            asset.fileMeta.sourcePath.parent.appended(new Editor.Path("Scripts/AutoFloorFinder.ts")),
            asset.fileMeta.sourcePath.parent.parent.parent.appended(new Editor.Path("Assets/Scripts/AutoFloorFinder.ts"))
          ];
          for (var i = 0; i < candidates.length && !scriptMeta; i++) {
            try {
              var m = assetManager.getFileMeta(candidates[i]);
              if (m && !Editor.isNull(m)) { scriptMeta = m; }
            } catch (pathErr) {}
          }
          if (!scriptMeta) { throw new Error("AutoFloorFinder.ts not found in package"); }
      
          var so = scene.addSceneObject(target ? target : null);
          so.name = "AutoFloorFinder";
          var comp = so.addComponent("ScriptComponent");
          comp.scriptAsset = scriptMeta.primaryAsset;
      
          // Wire the required camera input to the scene's main camera.
          var camera = null;
          var stack = [];
          for (var r = 0; r < scene.rootSceneObjects.length; r++) { stack.push(scene.rootSceneObjects[r]); }
          while (stack.length > 0 && !camera) {
            var o = stack.pop();
            var cams = o.getComponents("Camera");
            if (cams.length > 0) { camera = cams[0]; break; }
            for (var c = 0; c < o.children.length; c++) { stack.push(o.children[c]); }
          }
          if (camera) { comp["worldCamera"] = camera; }
          return so;
        } catch (e) {
          console.error("AutoFloorFinder setup failed: " + e);
          return instantiator.defaultInstantiate(asset, scene, target);
        }
      };

