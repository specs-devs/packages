  InputLines:
    - '// @ui {"widget":"group_start", "label":"Panel Scene Objects"}'
    - '// @input SceneObject panelTracking {"hint":"Tracking mode panel (also serves as intro/home)"}'
    - '// @input SceneObject panelSpeed {"hint":"Speed controls panel"}'
    - '// @input SceneObject panelMovements {"hint":"Movement limits panel"}'
    - '// @input SceneObject panelCharacter {"hint":"Character/wobble panel"}'
    - '// @input SceneObject panelPresets {"hint":"Presets panel"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Panel 1 - Tracking Mode"}'
    - '// @input AssignableType_1 trackingModeSwitch {"hint":"Main tracking mode toggle (Idle vs Look-At)"}'
    - '// @input AssignableType_2 robotModeToggleGroup {"hint":"Toggle group for Simulation vs Real Robot selection"}'
    - '// @input AssignableType_3 enableSimulationSwitch {"hint":"Enable Simulation mode switch"}'
    - '// @input AssignableType_4 enableReachySwitch {"hint":"Enable Real Robot mode switch"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Panel 2 - Speed Controls"}'
    - '// @input AssignableType_5 headYawSpeedSlider {"hint":"Head yaw speed slider (0.01-0.2)"}'
    - '// @input AssignableType_6 headPitchSpeedSlider {"hint":"Head pitch speed slider (0.01-0.2)"}'
    - '// @input AssignableType_7 bodyFollowSpeedSlider {"hint":"Body follow speed slider (0.01-0.2)"}'
    - '// @input AssignableType_8 antennaSpeedSlider {"hint":"Antenna speed slider (0.01-0.1)"}'
    - '// @input AssignableType_9 motionIntensitySlider {"hint":"Motion intensity slider (0.01-0.2)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Panel 3 - Movement Limits"}'
    - '// @input AssignableType_10 maxYawSlider {"hint":"Max yaw speed slider (1-10 degrees)"}'
    - '// @input AssignableType_11 maxPitchSlider {"hint":"Max pitch speed slider (0.5-5 degrees)"}'
    - '// @input AssignableType_12 maxAntennaSlider {"hint":"Max antenna speed slider (1-5 degrees)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Panel 4 - Character/Wobble"}'
    - '// @input AssignableType_13 enableWobbleSwitch {"hint":"Enable wobble toggle"}'
    - '// @input AssignableType_14 pitchWobbleSlider {"hint":"Pitch wobble slider (0-10 degrees)"}'
    - '// @input AssignableType_15 yawWobbleSlider {"hint":"Yaw wobble slider (0-10 degrees)"}'
    - '// @input AssignableType_16 rollWobbleSlider {"hint":"Roll wobble slider (0-15 degrees)"}'
    - '// @input AssignableType_17 baseAntennaSlider {"hint":"Base antenna movement slider (0-15 degrees)"}'
    - '// @input AssignableType_18 wobbleSpeedSlider {"hint":"Wobble speed slider (0.1-2.0)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Panel 5 - Presets"}'
    - '// @input AssignableType_19 presetToggleGroup {"hint":"Preset toggle group (manages Robotic/Natural/Expressive switches)"}'
    - '// @input AssignableType_20 roboticPresetSwitch {"hint":"Robotic preset switch"}'
    - '// @input AssignableType_21 naturalPresetSwitch {"hint":"Natural preset switch"}'
    - '// @input AssignableType_22 expressivePresetSwitch {"hint":"Expressive preset switch"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Navigation Buttons"}'
    - '// @input AssignableType_23 closeButton {"hint":"X button in top-left corner (returns to Tracking panel)"}'
    - '// @input AssignableType_24[] panelNavButtons {"hint":"Left sidebar panel navigation buttons array: [0]=Tracking, [1]=Speed, [2]=Movements, [3]=Character, [4]=Presets"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Controllers"}'
    - '// @input Component.ScriptComponent uiController {"hint":"ReachyUIController component"}'
    - '// @input Component.ScriptComponent reachyController {"hint":"ReachyMiniController component (the robot controller)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Logging Configuration</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Control logging output for this script instance</span>"}'
    - '// @input bool enableLogging {"hint":"Enable general logging (operations, events, etc.)"}'
    - '// @input bool enableLoggingLifecycle {"hint":"Enable lifecycle logging (onAwake, onStart, onUpdate, onDestroy, etc.)"}'
