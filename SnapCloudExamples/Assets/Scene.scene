- !<ScriptComponent/8dba7155-2ab8-4603-9ff5-5fbe92fade0a>
  PrefabRemaps:
    []
  Name: ExampleCarousel
  Enabled: true
  ScriptAsset: !<reference> 0e884fa8-2cbb-5a25-b415-aeb2d34ffd3c
  ScriptInputsDefault:
    startIndex: true
    previousLabel: true
    nextLabel: true
    examplesPushBack: true
    anchorExamples: true
    startMinimized: true
    extraPanelDrop: true
  ScriptTypesDefault:
    {}
  ScriptInputs:
    "":
      examples: !<reference.SceneObject[]>
        - !<reference> c6767c41-a40e-4b0e-8f4d-912e2f732284
        - !<reference> bcc906c8-b0b4-46ec-b114-de834b042f7e
        - !<reference> f789a4ab-deae-4603-a84d-6d7443fa38ab
        - !<reference> f50067c3-a797-4cc6-829a-f4ea812fc625
      exampleInfo: !<string[]>
        - "One basic per step, use its button on the panel: Table reads and writes rows, Realtime shares the arrow cursor (drag it), Storage downloads a model, image and audio, Edge Functions processes an image in the cloud. Setup: Window > Supabase > Import Credentials, then assign the project on [SnapCloudRequirements]."
        - "Pick a tab on the left: capture an image, video, audio or a composite and upload it to storage, or stream it live; Sharing records a Spotlight. The HD still capture works on device only."
        - "Press Start, then tap the button as fast as you can before the countdown ends: the score is submitted and the global leaderboard appears."
        - "One action per user, one shared total: sign in, join once, everyone sees the same live count. The pattern behind pledge or vote Lenses; SQL setup in Docs/global-counter.md."
      steps: !<reference.SceneObject[]>
        - !<reference> 2e66e360-32c9-4968-8272-b8666c12398c
        - !<reference> 2efa8f9f-45be-442c-984a-fe75cb03c773
        - !<reference> 4187bcaa-046a-43fb-b283-07c270f36dab
        - !<reference> c6ed5f31-f774-4df2-b703-653a5a5a187f
